// ======== BULLET PARSER ========
function parseBullets(text) {
  if (!text) return '';
  const lines = text.split('\n').map(l => l.replace(/^[•\-\*]\s*/, '').trim()).filter(l => l);
  if (lines.length <= 1) return `<p>${lines[0] || ''}</p>`;
  return '<ul>' + lines.map(l => `<li>${l}</li>`).join('') + '</ul>';
}

